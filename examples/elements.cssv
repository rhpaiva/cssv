---
/* The periodic table: one row per element, in atomic-number order. The
   table body becomes an 18-column grid, so row n is element n: most flow
   into place, and five rules move the rest. The category is the key column,
   and each category sets one color. */
table {
  --cssv-key: category;
  --bg: #0b0f1a;
  display: block;
  container-type: inline-size;
  min-width: 760px;
  padding: 20px;
  border-radius: 18px;
  font: 12px/1.15 system-ui, -apple-system, "Segoe UI", sans-serif;
  color: #e2e8f0;
  background:
    radial-gradient(90% 70% at 50% 0%, rgb(56 76 140 / 0.45), transparent 70%),
    var(--bg);
}
thead { display: none; }

tbody {
  display: grid;
  grid-template-columns: repeat(18, minmax(0, 1fr));
  grid-template-rows: repeat(7, auto) 14px repeat(2, auto);
  gap: 3px;
}

/* Rows flow into the grid in order; these start somewhere else. */
tr:nth-child(2) { grid-column: 18; }                    /* He: far right */
tr:nth-child(5), tr:nth-child(13) { grid-column: 13; }  /* B, Al: after the gap */
tr:nth-child(72), tr:nth-child(104) { grid-column: 4; } /* Hf, Rf: after the f-block */
tr:nth-child(n+57):nth-child(-n+71) { grid-row: 9; }    /* La–Lu */
tr:nth-child(n+89):nth-child(-n+103) { grid-row: 10; }  /* Ac–Lr */

/* The title fills the gap above the transition metals, and a label takes
   the first two columns of the f-block rows, so La and Ac start in column 3. */
tbody::after {
  content: "Periodic Table\A of the Elements";
  grid-area: 1 / 3 / 4 / 13;
  align-self: center;
  justify-self: center;
  white-space: pre;
  text-align: center;
  font-size: 2.3em;
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: #f8fafc;
  text-shadow: 0 0 30px rgb(120 150 255 / 0.5);
}
tbody::before {
  content: "57–71\A\A 89–103";
  grid-area: 9 / 1 / 11 / 3;
  align-self: center;
  justify-self: end;
  padding-inline-end: 8px;
  white-space: pre;
  text-align: end;
  font-size: 0.85em;
  line-height: 1.6;
  color: #64748b;
}

/* A tile per element. */
tr {
  --c: #94a3b8;
  position: relative;
  display: flex;
  flex-direction: column;
  aspect-ratio: 5 / 6;
  padding: 4px 5px;
  border: 1px solid color-mix(in oklab, var(--c) 40%, transparent);
  border-radius: 6px;
  background: color-mix(in oklab, var(--c) 14%, var(--bg));
  transition: transform 0.15s, background-color 0.15s, box-shadow 0.15s;
}
tr:hover {
  z-index: 1;
  transform: scale(1.45);
  background: color-mix(in oklab, var(--c) 30%, var(--bg));
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.6), 0 0 0 1px var(--c);
}
td { display: block; padding: 0; text-align: start; white-space: nowrap; }
td[data-col="number"] { font-size: 0.75em; color: color-mix(in oklab, var(--c) 55%, #fff); }
td[data-col="symbol"] { margin-top: auto; font-size: 1.55em; font-weight: 700; color: var(--c); }
td[data-col="name"], td[data-col="mass"] { overflow: hidden; text-overflow: ellipsis; font-size: 0.6em; }
td[data-col="mass"] { color: rgb(226 232 240 / 0.6); }
td[data-col="category"] { display: none; }

/* No stable isotope: the mass number of a long-lived one, in brackets.
   Thorium, protactinium and uranium have standard weights. */
tr:is(:nth-child(43), :nth-child(61), :nth-child(n+84)):not(:nth-child(n+90):nth-child(-n+92)) td[data-col="mass"]::before { content: "["; }
tr:is(:nth-child(43), :nth-child(61), :nth-child(n+84)):not(:nth-child(n+90):nth-child(-n+92)) td[data-col="mass"]::after { content: "]"; }

tr[data-key="alkali metal"] { --c: #ff6b6b; }
tr[data-key="alkaline earth metal"] { --c: #ff922b; }
tr[data-key="transition metal"] { --c: #fcc419; }
tr[data-key="post-transition metal"] { --c: #94d82d; }
tr[data-key="metalloid"] { --c: #20c997; }
tr[data-key="nonmetal"] { --c: #4dabf7; }
tr[data-key="halogen"] { --c: #748ffc; }
tr[data-key="noble gas"] { --c: #b197fc; }
tr[data-key="lanthanide"] { --c: #f783ac; }
tr[data-key="actinide"] { --c: #e599f7; }
tr[data-key="unknown"] { --c: #868e96; }

/* Narrow tables keep the number and the symbol. */
@container (width < 1000px) {
  td[data-col="name"], td[data-col="mass"] { display: none; }
  tbody::after { font-size: 1.7em; }
}
