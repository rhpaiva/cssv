---
/* cssv:title Jira board */
/* cssv:description A Jira CSV export, laid out as a board with a lane for
   each status. */
/* Status is the key, so each status gets a
   lane; dense packing stacks the cards in file order. Jira writes one column
   per sprint and per label under the same name, so [data-col="Labels"]
   styles every label column at once.
   Sample rows in Jira's format, trimmed to fifteen columns. */
table {
  --cssv-key: Status;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  grid-auto-flow: dense;
  gap: 8px 10px;
  width: 100%;
  min-width: 640px;
  contain: inline-size;
  padding: 14px;
  border-radius: 12px;
  color-scheme: light dark;
  --card: light-dark(#fff, #22272b);
  --chip: light-dark(#dfe1e6, #2c333a);
  --muted: light-dark(#5e6c84, #8c9bab);
  background: light-dark(#f4f5f7, #1d2125);
  font: 13px/1.4 system-ui, sans-serif;
  color: light-dark(#172b4d, #b6c2cf);
}
colgroup { display: none; }
thead, thead tr, tbody { display: contents; }

/* The first four column names become the lane titles. */
th { grid-row: 1; padding: 2px 4px 6px; font-size: 0; text-align: start; }
th:nth-child(n+5) { display: none; }
th::after { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--muted); }
th:nth-child(1)::after { content: "TO DO"; }
th:nth-child(2)::after { content: "IN PROGRESS"; }
th:nth-child(3)::after { content: "IN REVIEW"; }
th:nth-child(4)::after { content: "DONE"; }
tr[data-key="To Do"]       { grid-column: 1; }
tr[data-key="In Progress"] { grid-column: 2; }
tr[data-key="In Review"]   { grid-column: 3; }
tr[data-key="Done"]        { grid-column: 4; }

/* A card: summary, labels, then the key, the points and the assignee. */
tbody tr { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 10px; border-radius: 4px; background: var(--card); box-shadow: 0 1px 1px rgb(9 30 66 / 0.25); }
td { padding: 0; }
td:is([data-col="Issue id"], [data-col="Issue Type"], [data-col="Status"], [data-col="Priority"], [data-col="Reporter"], [data-col="Created"], [data-col="Updated"], [data-col="Sprint"]), td:empty { display: none; }
td[data-col="Summary"] { order: -1; flex-basis: 100%; }
td[data-col="Labels"] { padding: 1px 6px; border-radius: 3px; background: var(--chip); font-size: 11px; font-weight: 600; text-transform: uppercase; }
td[data-col="Issue key"] { order: 1; margin-right: auto; color: var(--muted); font-size: 12px; }
td[data-col="Custom field (Story Points)"] { order: 2; min-width: 22px; padding: 0 6px; border-radius: 11px; background: var(--chip); font-size: 12px; text-align: center; }
td[data-col="Assignee"] { order: 3; color: var(--muted); font-size: 12px; }
tr[data-key="Done"] td[data-col="Summary"] { color: var(--muted); text-decoration: line-through; }
---
