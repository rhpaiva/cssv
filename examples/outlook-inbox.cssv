---
/* An Outlook mail folder as Outlook exports it: File > Open & Export >
   Import/Export > Export to a file > Comma Separated Values. The export has
   19 columns, quotes every field, and has no dates, so the list keeps the
   folder's order. Sample mailbox; the people and companies are invented. */
table {
  --cssv-key: Importance;
  --list: 360px;
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  width: 100%;
  contain: inline-size;
  overflow: hidden;
  border-radius: 12px;
  counter-reset: items;
  color-scheme: light dark;
  --line: light-dark(#e1dfdd, #3b3a39);
  --muted: light-dark(#616161, #adadad);
  --accent: light-dark(#0f6cbd, #479ef5);
  --bg: light-dark(#fff, #262626);
  background: var(--bg);
  font: 13px/1.45 "Segoe UI", system-ui, sans-serif;
  color: light-dark(#242424, #f0f0f0);
}
colgroup, thead { display: none; }
td:not([data-col="From: (Name)"], [data-col="Subject"], [data-col="Body"], [data-col="Categories"]), td:empty { display: none; }

/* The bar: the item count is a counter over the rows, so it follows the data. */
table::before { content: "Inbox"; grid-area: 1 / 1 / 2 / -1; padding: 0 18px; border-bottom: 1px solid var(--line); font-size: 18px; font-weight: 600; line-height: 52px; }
table::after { content: counter(items) " items"; grid-area: 1 / 1; align-self: center; justify-self: end; margin-right: 14px; color: var(--muted); font-size: 12px; }
tbody { grid-area: 2 / 1; }

/* A message in the list: sender and category, subject, the start of the body.
   Rows keep their height, so nothing moves under the pointer. */
tr { counter-increment: items; display: grid; grid-template: "from tag" "subject subject" "body body" / minmax(0, 1fr) auto; align-content: center; column-gap: 10px; height: 72px; padding: 0 14px 0 18px; border-bottom: 1px solid var(--line); }
td { padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
[data-col="From: (Name)"] { grid-area: from; font-size: 14px; font-weight: 600; }
[data-col="Subject"] { grid-area: subject; }
[data-col="Body"] { grid-area: body; color: var(--muted); }
[data-col="Categories"] { grid-area: tag; align-self: center; padding: 0 7px; border-radius: 4px; background: light-dark(#ebf3fc, #1f3248); color: var(--accent); font-size: 11px; }

/* Importance is the key: High and Low get Outlook's marks, Normal none. */
[data-key="High"] > [data-col="From: (Name)"]::before { content: "!"; margin-right: 7px; color: light-dark(#c50f1f, #ff6b78); font-weight: 800; }
[data-key="Low"] > [data-col="From: (Name)"]::before { content: "\2193"; margin-right: 6px; color: var(--accent); }

/* With room for it, a reading pane shows the open message: the first one
   until another is clicked. Every message's body, address, To and Cc sit in
   the pane, the first message's on top. On a phone the list stands alone. */
@media (min-width: 760px) {
  table { grid-template-columns: var(--list) minmax(0, 1fr); min-width: 720px; }
  tr { height: 60px; cursor: pointer; transition: background-color 0s 999999s, box-shadow 0s 999999s; }
  tr:hover { background-image: linear-gradient(light-dark(#0000000a, #ffffff0d) 0 0); }
  :is([data-col="From: (Address)"], [data-col="To: (Name)"], [data-col="CC: (Name)"]):not(:empty) { display: block; position: absolute; left: calc(var(--list) + 32px); right: 32px; color: var(--muted); }
  [data-col="From: (Address)"] { top: 72px; }
  [data-col="To: (Name)"] { top: 94px; }
  [data-col="CC: (Name)"] { top: 116px; }
  [data-col="Body"] { grid-area: auto; position: absolute; inset: 52px 0 0 var(--list); padding: 104px 32px 24px; border-left: 1px solid var(--line); background: linear-gradient(var(--line) 0 0) 32px 90px / calc(100% - 64px) 1px no-repeat, var(--bg); overflow: auto; color: inherit; font-size: 14px; line-height: 1.6; white-space: pre-wrap; }
  tr:first-child > td { z-index: 1; }

  /* A click opens a message. While the button is down, the message is
     selected and every other message's pane hides, at once; when it comes up,
     the change back waits 999999 seconds, so the click holds. */
  td { transition: visibility 0s 999999s; }
  tbody:active :is(tr, td) { transition: none; }
  tr:is(:first-child, :active) { background-color: light-dark(#ebf3fc, #1f3248); box-shadow: inset 3px 0 var(--accent); }
  tbody:active > tr:not(:active) { background-color: transparent; box-shadow: none; }
  tbody:active > tr:not(:active) > :is([data-col="Body"], [data-col="From: (Address)"], [data-col="To: (Name)"], [data-col="CC: (Name)"]) { visibility: hidden; }
}
[data-col="From: (Address)"]::before { content: "From"; display: inline-block; width: 44px; }
[data-col="To: (Name)"]::before { content: "To"; display: inline-block; width: 44px; }
[data-col="CC: (Name)"]::before { content: "Cc"; display: inline-block; width: 44px; }
---
"Subject","Body","From: (Name)","From: (Address)","From: (Type)","To: (Name)","To: (Address)","To: (Type)","CC: (Name)","CC: (Address)","CC: (Type)","BCC: (Name)","BCC: (Address)","BCC: (Type)","Billing Information","Categories","Importance","Mileage","Sensitivity"
