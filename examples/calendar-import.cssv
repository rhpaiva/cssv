---
/* A week of events in Google Calendar's CSV import format, the file people
   build in a spreadsheet and upload. Here it's also the week, readable and
   printable. Start Date is the key: five rules put each date in its column,
   and a day's events stack in file order, which is time order.
   Sample rows. */
table {
  --cssv-key: "Start Date";
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  grid-auto-flow: dense;   /* each event takes the first free row in its column */
  gap: 6px;
  width: 100%;
  min-width: 600px;   /* narrower than that, the page scrolls the week sideways */
  contain: inline-size;
  padding: 14px;
  border-radius: 12px;
  color-scheme: light dark;
  --event: light-dark(#e8f0fe, #233554);
  --blue: light-dark(#1967d2, #8ab4f8);
  --muted: light-dark(#5f6368, #9aa0a6);
  background: light-dark(#fff, #1f1f1f);
  font: 12px/1.35 system-ui, sans-serif;
  color: light-dark(#1f2937, #e3e3e3);
}
colgroup { display: none; }
thead, thead tr, tbody { display: contents; }

/* The first five column names become the weekdays. */
th { grid-row: 1; padding: 0 0 6px; border-bottom: 2px solid light-dark(#e5e7eb, #3c4043); font-size: 0; text-align: start; }
th:nth-child(n+6) { display: none; }
th::after { font-size: 12px; color: var(--muted); }
th:nth-child(1)::after { content: "Mon 5"; }
th:nth-child(2)::after { content: "Tue 6"; }
th:nth-child(3)::after { content: "Wed 7"; }
th:nth-child(4)::after { content: "Thu 8"; }
th:nth-child(5)::after { content: "Fri 9"; }
tr[data-key="10/05/2026"] { grid-column: 1; }
tr[data-key="10/06/2026"] { grid-column: 2; }
tr[data-key="10/07/2026"] { grid-column: 3; }
tr[data-key="10/08/2026"] { grid-column: 4; }
tr[data-key="10/09/2026"] { grid-column: 5; }

/* Each event: time, title, place. */
tbody tr { display: flex; flex-wrap: wrap; column-gap: 4px; padding: 6px 8px; border-left: 3px solid var(--blue); border-radius: 6px; background: var(--event); }
td { padding: 0; }
td:is([data-col="Start Date"], [data-col="End Date"], [data-col="All Day Event"], [data-col="Description"], [data-col="Private"]) { display: none; }
td:is([data-col="Start Time"], [data-col="End Time"]) { color: var(--blue); font-size: 11px; }
td[data-col="End Time"]:not(:empty)::before { content: "– "; }
td[data-col="Subject"] { order: 1; flex-basis: 100%; font-weight: 600; }
td[data-col="Location"] { order: 2; color: var(--muted); font-size: 11px; }

/* All-day events leave the times empty. */
tr:has(> [data-col="Start Time"]:empty) { --blue: #fff; border-left-color: #0b57d0; background: #0b57d0; color: #fff; }
---
