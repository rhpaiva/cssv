---
/* cssv:title Bitcoin by the week */
/* cssv:description A year of Bitcoin prices from CoinGecko's daily export,
   drawn as weekly candles. */
/* CoinGecko's daily price export has one record a
   day, with the price at midnight UTC. The price is the key column, so
   typed attr() turns it into a height, and every seven records from a
   Monday are a week: a candle. The other columns draw it. Each day's date
   is a line from Monday's price to the day's, and together the lines cover
   the week's range: the wick. On the week's last day, market cap and
   volume are the body from Monday's price to the day's: market cap in
   green as if the week went up, volume in red as if it went down. The
   wrong one gets a negative height, which is no height at all. Give the
   table a new file with update() and the newest candle grows. */
table {
  --cssv-key: close_price_usd;
  --lo: 50000;   /* the price axis in dollars, set by tools/bitcoin-data.js */
  --hi: 140000;
  --step: 10000; /* a grid line every */
  --weeks: 53;   /* candles: 52 weeks and this one */
  --h: 400px;
  --axis: 52px;
  --up: #089981;
  --down: #f23645;
  --grid: light-dark(#eceff4, #232733);
  --wick: light-dark(#8b93a1, #6b7280);
  --ink: light-dark(#131722, #d1d4dc);
  display: block;
  padding: 12px 0 12px 12px;
  border-radius: 12px;
  color-scheme: light dark;
  color: var(--ink);
  background: light-dark(#fff, #131722);
  font: 11px/1 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}
@media (max-width: 640px) { table { --h: 260px; --axis: 40px; font-size: 10px; } }
colgroup, thead { display: none; }
tbody {
  --line: calc(var(--h) * var(--step) / (var(--hi) - var(--lo)));
  display: block;
  position: relative;
  height: var(--h);
  overflow: clip;
  background: repeating-linear-gradient(var(--grid) 0 1px, transparent 0 var(--line));
}
tbody::before {
  content: "BTC / USD · 1W · CoinGecko";
  position: absolute;
  top: 8px;
  left: 8px;
  font-weight: 600;
}
/* The price axis: a line of text for each grid line, in thousands. */
tbody::after {
  counter-reset:
    a calc((var(--hi) - 1 * var(--step)) / 1000) b calc((var(--hi) - 2 * var(--step)) / 1000)
    c calc((var(--hi) - 3 * var(--step)) / 1000) d calc((var(--hi) - 4 * var(--step)) / 1000)
    e calc((var(--hi) - 5 * var(--step)) / 1000) f calc((var(--hi) - 6 * var(--step)) / 1000)
    g calc((var(--hi) - 7 * var(--step)) / 1000) h calc((var(--hi) - 8 * var(--step)) / 1000)
    i calc((var(--hi) - 9 * var(--step)) / 1000);
  content: counter(a) "k\A" counter(b) "k\A" counter(c) "k\A" counter(d) "k\A" counter(e) "k\A"
    counter(f) "k\A" counter(g) "k\A" counter(h) "k\A" counter(i) "k";
  position: absolute;
  top: calc(var(--line) / 2);
  bottom: calc(var(--line) / 2); /* no label on the bottom edge */
  right: 0;
  width: var(--axis);
  overflow: hidden;
  line-height: var(--line);
  white-space: pre;
  text-align: center;
  color: light-dark(#6a7180, #8a91a0);
}

/* A record's place in the file gives its week, and its price the height. */
tr {
  --w: calc((100% - var(--axis)) / var(--weeks));
  --y: calc((var(--hi) - attr(data-key type(<number>), 0)) / (var(--hi) - var(--lo)) * 100%);
  display: contents;
  left: calc((round(down, (sibling-index() - 1) / 7) + 0.5) * var(--w));
}
td {
  position: absolute;
  left: inherit;
  padding: 0;
  font-size: 0;
}
td[data-col="close_price_usd"] { --cssv-format: "maximumFractionDigits: 0"; top: var(--y); }
tr:nth-child(7n + 1) td[data-col="close_price_usd"] { anchor-name: --monday; }

/* The wick: a line from Monday's price to the day's. Monday has none: its
   date comes before its price, so it would reach back to last week. */
td[data-col="event_date"] {
  width: 1px;
  top: min(anchor(--monday center), var(--y));
  bottom: min(anchor(--monday center), 100% - var(--y));
  background: var(--wick);
}
tr:nth-child(7n + 1) td[data-col="event_date"] { display: none; }

/* The body, on Sundays and on the newest day. A week that ends where it
   started gets a line. */
td:is([data-col="market_cap_usd"], [data-col="volume_usd"]) { display: none; }
tr:is(:nth-child(7n), :last-child) td:is([data-col="market_cap_usd"], [data-col="volume_usd"]) {
  display: block;
  width: calc(var(--w) * 0.72);
  margin-left: calc(var(--w) * -0.36);
}
td[data-col="market_cap_usd"] { top: calc(var(--y) - 1px); bottom: anchor(--monday center); min-height: 1px; background: var(--up); }
td[data-col="volume_usd"] { top: anchor(--monday center); bottom: calc(100% - var(--y)); background: var(--down); }

/* The newest day: its price on the axis and its date in the corner. */
tr:last-child td[data-col="close_price_usd"] {
  z-index: 1;
  left: auto;
  right: 0;
  width: var(--axis);
  height: 18px;
  margin-top: -9px;
  border-radius: 2px;
  font-size: 10.5px;
  font-weight: 600;
  line-height: 18px;
  text-align: center;
  color: light-dark(#fff, #131722);
  background: var(--ink);
}
tr:last-child td[data-col="close_price_usd"]::before {
  content: "";
  position: absolute;
  top: 50%;
  right: 100%;
  width: 100vw;
  border-top: 1px dashed var(--wick);
}
tr:last-child td[data-col="event_date"] {
  display: block;
  top: 8px;
  bottom: auto;
  left: calc(8px + 28ch);
  width: 10ch;
  overflow: hidden;
  font-size: 11px;
  white-space: nowrap;
  color: light-dark(#6a7180, #8a91a0);
  background: none;
}

/* Without typed attr(), sibling-index() or anchor positioning, the dates
   and prices as a list. */
@supports not ((anchor-name: --a) and (order: sibling-index()) and (width: attr(data-key type(<length>), 0px))) {
  tbody { height: auto; max-height: var(--h); overflow: auto; background: none; }
  tbody::before, tbody::after { content: none; }
  tr { display: table-row; }
  tr:nth-child(n) td[data-col] {
    display: table-cell; position: static; margin: 0; padding: 3px 12px;
    font-size: 12px; color: inherit; background: none;
  }
  tr:nth-child(n) td:is([data-col="market_cap_usd"], [data-col="volume_usd"]) { display: none; }
  tr:last-child td[data-col="close_price_usd"]::before { content: none; }
}
---
event_date,close_price_usd,market_cap_usd,volume_usd
2025-10-06 00:00:00 UTC,124739.81088811433,2461262484402.037,72019647929.19965
