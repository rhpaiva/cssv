---
/* Ticketlark's seating plan for Northbridge FC v Harbor City: a record per
   section, with its stand, tier, category, price, seats and the seats left.
   Records run clockwise from the halfway line, tier by tier, so
   sibling-index() gives each section its place in the bowl: the lower
   tier's 44 sections, the club level's 36, the upper tier's 52. The
   category is the key column and colors the section; a section with no
   seats left is .zero. Point at a section to read its record. */
table {
  --cssv-key: category;
  --ink: light-dark(#1f2933, #e6e9ef);
  --muted: light-dark(#6b7480, #8b94a3);
  --gone: light-dark(#d4d9e0, #2a2f39);
  --gone-2: light-dark(#e4e8ed, #20242c);
  --grass: light-dark(#4f9d57, #2e6b38);
  --stripe: light-dark(#5aa862, #33753e);
  --line: rgb(255 255 255 / 0.85);
  --panel: light-dark(rgb(255 255 255 / 0.94), rgb(17 20 27 / 0.94));
  --before: "€";
  --after: "";
  color-scheme: light dark;
  display: block;
  position: relative;
  max-width: 960px;
  margin-inline: auto;
  padding: 2.4em 2.4em;
  font: 600 12px/1.2 system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--ink);
}
table:is(:lang(de), :lang(fr)) { --before: ""; --after: "\2009€"; }
@media (width < 640px) { table { font-size: 8px; } }
colgroup, thead tr { display: none; }
thead { display: contents; }

/* The stands' names, around the bowl. */
table::before, table::after, thead::before, thead::after {
  position: absolute;
  font-size: 0.85em;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
}
table::before { content: "North Stand"; top: 0.8em; left: 50%; translate: -50%; }
table::after { content: "South Stand"; bottom: 0.8em; left: 50%; translate: -50%; }
thead::before { content: "West Stand"; left: 0.8em; top: 50%; translate: 0 -50%; writing-mode: vertical-rl; rotate: 180deg; }
thead::after { content: "East Stand"; right: 0.8em; top: 50%; translate: 0 -50%; writing-mode: vertical-rl; }

/* The bowl, and the pitch in the middle of it. */
tbody {
  --ratio: 1.36;
  display: block;
  position: relative;
  aspect-ratio: var(--ratio);
  container-type: inline-size;
}
tbody::before, tbody::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 42%;
  translate: -50% -50%;
}
tbody::before {
  aspect-ratio: 105 / 68;
  border: 2px solid var(--line);
  background:
    radial-gradient(circle, var(--line) 3px, transparent 3.5px),
    radial-gradient(circle, transparent 13%, var(--line) 0 calc(13% + 2px), transparent 0),
    linear-gradient(90deg, transparent calc(50% - 1px), var(--line) 0 calc(50% + 1px), transparent 0),
    repeating-linear-gradient(90deg, var(--grass) 0 10%, var(--stripe) 0 20%);
}
/* The penalty areas: one box, its middle masked away. */
tbody::after {
  aspect-ratio: 105 / 35;
  border-block: 2px solid var(--line);
  background: linear-gradient(90deg, transparent 16%, var(--line) 0 calc(16% + 2px), transparent 0 calc(84% - 2px), var(--line) 0 84%, transparent 0);
  mask: linear-gradient(90deg, #000 calc(16% + 2px), transparent 0 calc(84% - 2px), #000 0);
}

/* A section is a layer over the whole bowl. Its row's place in its tier is
   an angle, and the tier's two radii make the wedge; the bowl's outline
   is a squircle, so the sides run straight and the corners round. */
tbody tr {
  --first: 0; --n: 44; --in: 25; --out: 34.5;
  --i: calc(sibling-index() - 1 - var(--first));
  --a0: calc((var(--i) + 0.04) * 360deg / var(--n) - 90deg);
  --a1: calc((var(--i) + 0.96) * 360deg / var(--n) - 90deg);
  --am: calc((var(--i) + 0.5) * 360deg / var(--n) - 90deg);
  --s0: pow(pow(cos(var(--a0)), 4) + pow(sin(var(--a0)), 4), -0.25);
  --s1: pow(pow(cos(var(--a1)), 4) + pow(sin(var(--a1)), 4), -0.25);
  --sm: calc(pow(pow(cos(var(--am)), 4) + pow(sin(var(--am)), 4), -0.25) * (var(--in) + var(--out)) / 2);
  position: absolute;
  inset: 0;
  box-sizing: border-box;
  /* The section number sits in the middle of the wedge. */
  padding-left: calc(50% + cos(var(--am)) * var(--sm) * 1%);
  padding-top: calc((50% + sin(var(--am)) * var(--sm) * 1%) / var(--ratio));
  pointer-events: none;
}
tbody tr:nth-child(n+45) { --first: 44; --n: 36; --in: 35.3; --out: 38.8; }
tbody tr:nth-child(n+81) { --first: 80; --n: 52; --in: 39.6; --out: 49.4; }
tbody tr::before {
  content: "";
  position: absolute;
  inset: 0;
  clip-path: polygon(
    calc(50% + var(--in) * cos(var(--a0)) * var(--s0) * 1%) calc(50% + var(--in) * sin(var(--a0)) * var(--s0) * 1%),
    calc(50% + var(--out) * cos(var(--a0)) * var(--s0) * 1%) calc(50% + var(--out) * sin(var(--a0)) * var(--s0) * 1%),
    calc(50% + var(--out) * cos(var(--a1)) * var(--s1) * 1%) calc(50% + var(--out) * sin(var(--a1)) * var(--s1) * 1%),
    calc(50% + var(--in) * cos(var(--a1)) * var(--s1) * 1%) calc(50% + var(--in) * sin(var(--a1)) * var(--s1) * 1%));
  background: var(--color);
  pointer-events: auto;
}
td { display: none; padding: 0; }
td[data-col="section"] {
  display: block;
  width: max-content;
  translate: -50% -50%;
  font-size: 0.95cqw;
  color: #fff;
}

/* Categories, from the key column, and sold-out sections from .zero. */
[data-key="Category 1"] { --color: light-dark(#5f3dc4, #7048e8); }
[data-key="Category 2"] { --color: light-dark(#1971c2, #228be6); }
[data-key="Category 3"] { --color: light-dark(#0c8599, #1098ad); }
[data-key="Category 4"] { --color: light-dark(#d9480f, #e8590c); }
[data-key="Hospitality"] { --color: light-dark(#a07800, #b8901a); }
tbody tr:has(.zero[data-col="available"]) { --color: repeating-linear-gradient(-45deg, var(--gone) 0 4px, var(--gone-2) 0 7px); }
tbody tr:has(.zero[data-col="available"]) td[data-col="section"] { color: var(--muted); }

/* Pointing at a section lights it up, and the rest of its record shows
   over the pitch in three pairs: stand and tier, category and price, seats
   and seats left. */
tbody tr:hover { z-index: 1; }
tbody tr:hover::before { filter: brightness(1.25) saturate(1.1); }
tbody tr:hover:has(.zero[data-col="available"]) { --color: var(--muted); }
tbody tr:hover:has(.zero[data-col="available"]) td[data-col="section"] { color: light-dark(#fff, #11141b); }
tbody tr:hover::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: -1;
  width: 22cqw;
  height: 9cqw;
  translate: -50% -50%;
  border-radius: 1cqw;
  background: var(--panel);
  box-shadow: 0 0.6cqw 2cqw rgb(15 23 42 / 0.35);
}
tbody tr:hover td:not([data-col="section"]) { display: block; position: absolute; top: 50%; font-size: 1.25cqw; }
tbody tr:hover td:is([data-col="stand"], [data-col="category"], [data-col="seats"]) { right: 50%; margin-right: 0.75cqw; font-weight: 500; color: var(--muted); }
tbody tr:hover td:is([data-col="tier"], [data-col="price"], [data-col="available"]) { left: 50%; margin-left: 0.75cqw; font-weight: 700; }
tbody tr:hover td:is([data-col="stand"], [data-col="tier"]) { translate: 0 -200%; }
tbody tr:hover td:is([data-col="category"], [data-col="price"]) { translate: 0 -50%; }
tbody tr:hover td:is([data-col="seats"], [data-col="available"]) { translate: 0 100%; }
td[data-col="price"]::before { content: var(--before); }
td[data-col="price"]::after { content: var(--after); }
td:is([data-col="seats"], [data-col="available"]) { --cssv-format: "maximumFractionDigits: 0"; }
td[data-col="seats"]::after { content: " seats"; }
td[data-col="available"]::after { content: " left"; }
tbody tr:hover td.zero[data-col="available"] { font-size: 0; }
td.zero[data-col="available"]::after { content: "Sold out"; font-size: 1.25cqw; }

/* Without sibling-index(), the sections are a list of chips. */
@supports not (order: sibling-index()) {
  tbody { display: flex; flex-wrap: wrap; gap: 3px; aspect-ratio: auto; }
  :is(table, thead, tbody)::before, :is(table, thead, tbody)::after { display: none; }
  tbody tr { position: relative; padding: 0.4em 0.6em; }
  tbody tr::before { clip-path: none; }
  tbody tr:hover::after, tbody tr:hover td:not([data-col="section"]) { display: none; }
  td[data-col="section"] { position: relative; translate: none; font-size: 1em; }
}
