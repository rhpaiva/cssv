---
/* git log, as a changelog card. Made with:
   git log -18 --shortstat --format='%ad%x09%h%x09%s' --date=short
   and a few lines of Node that write one CSV line per commit, with the
   deleted lines as a negative number. */
table {
  width: 100%;
  border-collapse: collapse;
  color-scheme: light dark;
  --muted: light-dark(#9ca3af, #8a8780);
  background: light-dark(#fff, #1b1b19);
  font: 13px/1.45 system-ui, sans-serif;
  color: light-dark(#1f2937, #e5e7eb);
}
thead { display: none; }
td { padding: 7px 8px; border-bottom: 1px solid light-dark(#eef0f3, #2c2b27); vertical-align: baseline; }
[data-col="date"] { color: var(--muted); font-size: 12px; white-space: nowrap; }
[data-col="commit"] { font: 12px ui-monospace, Menlo, Consolas, monospace; color: light-dark(#6d28d9, #c4b5fd); }
.number { white-space: nowrap; }
[data-col="files"]::after { content: " files"; color: var(--muted); }
[data-col="added"].positive { color: light-dark(#15803d, #4ade80); font-weight: 600; }
[data-col="added"].positive::before { content: "+"; }
[data-col="removed"].negative { color: light-dark(#b91c1c, #f87171); font-weight: 600; }
.zero { color: light-dark(#d1d5db, #4b4a45); }
---
date,commit,subject,files,added,removed
2026-10-04,ddfd6c7,0.2.0,2,3,-3
